---
const isChinese = Astro.locals.starlightRoute.lang === 'zh-CN';
const label = isChinese ? '切换深色或浅色主题' : 'Toggle dark or light theme';
---

<starlight-theme-toggle>
  <button type="button" class="theme-toggle" aria-label={label} title={label}>
    <span class="track" aria-hidden="true">
      <span class="thumb">
        <svg class="sun" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24">
          <path d="M20.3 15.5A8.5 8.5 0 0 1 8.5 3.7 8.5 8.5 0 1 0 20.3 15.5Z" fill="currentColor"></path>
        </svg>
      </span>
    </span>
  </button>
</starlight-theme-toggle>

<script>
  type Theme = 'dark' | 'light';

  const storageKey = 'starlight-theme';
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function systemTheme(): Theme {
    return media.matches ? 'dark' : 'light';
  }

  function storedTheme(): Theme | null {
    const value = localStorage.getItem(storageKey);
    return value === 'dark' || value === 'light' ? value : null;
  }

  function applyTheme(theme: Theme, remember = false): void {
    document.documentElement.dataset.theme = theme;
    if (remember) localStorage.setItem(storageKey, theme);
    document.querySelectorAll('starlight-theme-toggle button').forEach((button) => {
      button.setAttribute('aria-pressed', String(theme === 'dark'));
    });
  }

  if (!customElements.get('starlight-theme-toggle')) {
    customElements.define(
      'starlight-theme-toggle',
      class extends HTMLElement {
        connectedCallback() {
          applyTheme(storedTheme() ?? systemTheme());
          this.querySelector('button')?.addEventListener('click', () => {
            const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            applyTheme(next, true);
          });
        }
      },
    );

    media.addEventListener('change', () => {
      if (!storedTheme()) applyTheme(systemTheme());
    });
  }
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    min-width: 2.9rem;
    min-height: 2rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .track {
    position: relative;
    width: 2.5rem;
    height: 1.4rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .thumb {
    position: absolute;
    inset-block-start: 0.15rem;
    inset-inline-start: 0.15rem;
    display: grid;
    width: 1rem;
    height: 1rem;
    place-items: center;
    border-radius: 50%;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    box-shadow: 0 1px 3px color-mix(in srgb, var(--sl-color-white) 24%, transparent);
    transition: transform 160ms ease;
  }

  :global([data-theme='dark']) .thumb {
    transform: translateX(1.05rem);
  }

  :global([dir='rtl'][data-theme='dark']) .thumb {
    transform: translateX(-1.05rem);
  }

  svg {
    width: 0.7rem;
    height: 0.7rem;
  }

  .moon,
  :global([data-theme='dark']) .sun {
    display: none;
  }

  :global([data-theme='dark']) .moon {
    display: block;
  }

  .theme-toggle:hover .track,
  .theme-toggle:focus-visible .track {
    border-color: var(--sl-color-accent);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
    border-radius: 999px;
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .thumb {
      transition: none;
    }
  }
</style>
